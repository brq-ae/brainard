# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (consumed by the `db` service to initialize the container) ---
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=brain

# --- API (consumed by the `api` service) ---
# Async SQLAlchemy URL. Keep the credentials/db name in sync with the
# POSTGRES_* values above -- Postgres and the API read these independently.
DATABASE_URL=postgresql+asyncpg://brain:change-me-to-a-strong-password@db:5432/brain

# Host port the API is published on (see docker-compose.yml).
API_PORT=8300

# --- Tests only (the profile-gated `test` service; see docs/dev.md) ---
# Same credentials, distinct database name so tests never touch dev data.
TEST_DATABASE_URL=postgresql+asyncpg://brain:change-me-to-a-strong-password@db:5432/brain_test

# --- UI (phase 6; consumed by the `api` service) ---
# Signs the owner UI session cookie (app/ui_auth.py). Optional: if unset, a
# random secret is generated once per process at startup -- fine for a LAN,
# single-owner deployment (a restart just logs everyone out; log back in
# with the same owner token), but set this explicitly if UI sessions should
# survive a restart. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
UI_SESSION_SECRET=

# Set true only when the UI is served behind TLS -- LAN deployments are
# commonly plain http, where a Secure cookie would never be sent at all.
UI_COOKIE_SECURE=false

# Optional: overrides the hub base URL embedded in generated onboarding
# prompts (app/onboarding.py) -- set this if the hub is reachable at a
# different address than the one the owner's browser used to mint a machine
# (reverse proxy, port-forward, VPN). Leave unset to use the request's own
# base URL (the default, and correct for a plain LAN deployment).
HUB_PUBLIC_URL=

# Optional: the Brain's direct LAN address (e.g. http://192.0.2.10:8300)
# -- plain HTTP, no reverse proxy, no DNS involved. When set, generated
# onboarding/room-join prompts (app/onboarding.py) append a failsafe line
# pointing agents at this address, for machines whose DNS is a public
# resolver (e.g. 8.8.8.8) and so can't resolve an intranet hostname like the
# one HUB_PUBLIC_URL points at. Leave unset to omit the failsafe line.
HUB_FALLBACK_URL=

# --- LLM provider config (ADR-0010 phase 1; consumed by the `api` service)
# ---
# Optional env override for the built-in librarian's LLM provider,
# normally configured via the owner UI/API (POST /v1/llm-config, /ui/llm)
# and stored -- versioned, immutably -- in the `llm_configs` table. When
# BOTH LLM_BASE_URL and LLM_MODEL are set here, they take precedence over
# whatever is stored in the database and the database is NEVER written to
# by this override (the owner UI still accepts and stores POSTs, but they
# have no effect on the *effective* config while these env vars are set --
# see app/llm_config.py's `resolve_llm_config`). Leave both unset (the
# default) to use the stored config instead.
#
# Any OpenAI-compatible chat-completions endpoint works: Ollama
# (http://ollama:11434/v1, model e.g. llama3.1, no key needed), OpenAI
# (https://api.openai.com/v1), OpenRouter, LM Studio, vLLM.
LLM_BASE_URL=
LLM_MODEL=
# Optional -- omit entirely for Ollama and other local endpoints that need
# no key. Never logged, never served back in full by any API/UI response
# (masked to a last-4-chars hint only). NOT encrypted at rest (ADR-0010
# decision 3) -- database backups will contain it if set via the stored
# path instead of this env override.
LLM_API_KEY=

# --- LLM call timeouts (consumed by the `api` service) ---
# WHY these are configurable: hosted APIs (OpenAI, OpenRouter, ...) answer
# in a second or two, but a LOCAL model (Ollama, LM Studio, vLLM on modest
# hardware) or any REASONING model (one that emits a long chain-of-thought
# before it ever writes the actual answer) can legitimately take minutes --
# a real deployment hit exactly this with a local reasoning model and a
# hardcoded 30s timeout, surfacing as a confusing "transport error
# (ReadTimeout)" even though the model was still working. Raise these if
# you see that; both are read once at startup (a change requires a
# restart), bounded to 5-1800 seconds (an out-of-range value fails
# startup with a clear error rather than being silently clamped).
#
# Per-call timeout for room AI actions (app/room_ai.py) and the built-in
# librarian's judgment calls (app/librarian_engine.py). Default 180s.
LLM_CALL_TIMEOUT_SECS=180
# Timeout for the "Test connection" probe (/ui/llm, POST
# /v1/llm-config/test) -- shorter than the call timeout above since it's a
# quick sanity check, but long enough to survive a cold local model load.
# Default 60s.
LLM_TEST_TIMEOUT_SECS=60

# Optional: overrides the timeout on the SYNCHRONOUS "Run now" librarian
# request (owner UI's /ui/librarian, POST /v1/librarian/run) -- the nightly
# SCHEDULED run has no such wrapper and is NOT affected by this setting.
# Left unset (the default), the effective wrapper timeout is DERIVED from
# the run's actual LLM-call budget (max_llm_calls * LLM_CALL_TIMEOUT_SECS,
# floored at 600s so it's never shorter than the old flat default, capped
# at a sane ceiling) rather than a flat number -- see
# app/routers/librarian.py's `effective_inline_run_timeout_secs`. Set this
# only to override that derivation outright. Bounded 60-7200 seconds; an
# out-of-range value fails startup with a clear error.
LIBRARIAN_INLINE_RUN_TIMEOUT_SECS=

# --- Backups (phase 7; consumed by scripts/backup.sh, run on the Docker
# host, NOT by the api/db containers) ---
# Where nightly pg_dump + git bundle backups get pushed over SSH/rsync,
# in addition to the local backups/ directory that scripts/backup.sh always
# writes first. No backup machine exists yet (docs/vision.md "Open
# build-time inputs: backup target machine") -- leave all three unset and
# scripts/backup.sh runs in local-only "placeholder mode", logging that the
# remote push was skipped rather than failing. Fill these in once the
# backup machine exists; see docs/ops.md for the restore procedure and the
# host-side cron line.
BACKUP_TARGET_HOST=
BACKUP_TARGET_USER=
BACKUP_TARGET_PATH=
