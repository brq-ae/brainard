# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (consumed by the `db` service to initialize the container) ---
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=brain

# --- API (consumed by the `api` service) ---
# Async SQLAlchemy URL. Keep the credentials/db name in sync with the
# POSTGRES_* values above -- Postgres and the API read these independently.
DATABASE_URL=postgresql+asyncpg://brain:change-me-to-a-strong-password@db:5432/brain

# Host port the API is published on (see docker-compose.yml).
API_PORT=8300

# --- Tests only (the profile-gated `test` service; see docs/dev.md) ---
# Same credentials, distinct database name so tests never touch dev data.
TEST_DATABASE_URL=postgresql+asyncpg://brain:change-me-to-a-strong-password@db:5432/brain_test

# --- UI (phase 6; consumed by the `api` service) ---
# Signs the owner UI session cookie (app/ui_auth.py). Optional: if unset, a
# random secret is generated once per process at startup -- fine for a LAN,
# single-owner deployment (a restart just logs everyone out; log back in
# with the same owner token), but set this explicitly if UI sessions should
# survive a restart. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
UI_SESSION_SECRET=

# Set true only when the UI is served behind TLS -- LAN deployments are
# commonly plain http, where a Secure cookie would never be sent at all.
UI_COOKIE_SECURE=false

# --- Backups (phase 7; consumed by scripts/backup.sh, run on the Docker
# host, NOT by the api/db containers) ---
# Where nightly pg_dump + git bundle backups get pushed over SSH/rsync,
# in addition to the local backups/ directory that scripts/backup.sh always
# writes first. No backup machine exists yet (docs/vision.md "Open
# build-time inputs: backup target machine") -- leave all three unset and
# scripts/backup.sh runs in local-only "placeholder mode", logging that the
# remote push was skipped rather than failing. Fill these in once the
# backup machine exists; see docs/ops.md for the restore procedure and the
# host-side cron line.
BACKUP_TARGET_HOST=
BACKUP_TARGET_USER=
BACKUP_TARGET_PATH=
